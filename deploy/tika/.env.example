# Variables for docker-compose.dokploy.yml. All optional; paste any you change into the Dokploy deployment's
# Environment tab. Tika has no password.

# In the backend's Environment tab (API and worker):
#   TIKA_ENABLED=true
#   TIKA_URL=http://ugarms-tika:9998

# TIKA_VERSION=4.2.0      # image tag; pin a version rather than "latest" so upgrades happen when you choose
# TIKA_HEAP=1g            # Java memory; raise it if large documents fail to extract
# TIKA_HOST_PORT=9998     # port on the server's loopback address, for SSH tunnels
# TZ=Africa/Accra
