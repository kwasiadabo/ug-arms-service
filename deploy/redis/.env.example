# Variables for docker-compose.dokploy.yml. Paste these into the Dokploy deployment's Environment tab with your own
# values. Never commit real values.

# Letters and digits only, so it can go into REDIS_URL unescaped: openssl rand -hex 32
REDIS_PASSWORD=

# In the backend's Environment tab (API and worker):
#   REDIS_URL=redis://:<REDIS_PASSWORD>@ugarms-redis:6379

# Optional.
# REDIS_MAXMEMORY=512mb     # Redis refuses new jobs (it never drops queued ones) once this is reached
# REDIS_HOST_PORT=6379      # port on the server's loopback address, for SSH tunnels
