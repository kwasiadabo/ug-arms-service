# Variables for docker-compose.dokploy.yml (API and worker). Paste these into the Dokploy deployment's Environment tab
# with your own values (Dokploy writes them to .env beside the compose file). Never commit real values.
#
# One variable per line, each name once, no comments at the ends of lines. Avoid $ in values (Compose treats it as
# the start of a variable).

# Database: the same DB_NAME, DB_USER and DB_PASSWORD as the SQL Server deployment (deploy/mssql).
DB_NAME=db_ug_arms
DB_USER=ugarms_app
DB_PASSWORD=

# Redis: the same REDIS_PASSWORD as the Redis deployment (deploy/redis).
REDIS_PASSWORD=

# Object storage: the same values as the SeaweedFS deployment (deploy/seaweedfs). The disposal pair must differ from
# the application pair; it goes to the API only.
S3_BUCKET=ug-arms-objects
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_DISPOSAL_ACCESS_KEY=
S3_DISPOSAL_SECRET_KEY=

# Sign-in tokens: two different random values of at least 48 characters (openssl rand -hex 32).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The address people open in the browser, and the proxy count in front of the API: 2 behind the web application
# (Traefik, then Nginx), 1 when browsers use the API's own domain.
PUBLIC_APP_URL=https://archives.example.org
CORS_ORIGINS=https://archives.example.org
TRUST_PROXY=2

# E-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=UG Archives <no-reply@example.org>

# First administrator. Remove SEED_ADMIN_PASSWORD after the first sign-in (at least 12 characters, not "changeme").
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional.
# Copies of the API behind Traefik (default 2); each uses about 150 MB of memory.
# API_REPLICAS=2
# TIKA_ENABLED=true
# OCR_CONCURRENCY=2
# SWAGGER_ENABLED=false
