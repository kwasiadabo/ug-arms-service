# Variables for docker-compose.dokploy.yml. Paste these into the Dokploy deployment's Environment tab with your own
# values. Never commit real values. Keys and secrets must not contain quotes or backslashes; letters and digits
# are safest (openssl rand -hex 20 for a key, openssl rand -hex 32 for a secret).

# Bucket name: lower case letters, digits, dots and hyphens.
S3_BUCKET=ug-arms-objects

# Application (API and worker): store and read files, set and extend retention.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Authorised disposal (API only). Optional; see the comment in docker-compose.dokploy.yml.
S3_DISPOSAL_ACCESS_KEY=
S3_DISPOSAL_SECRET_KEY=

# In the backend's Environment tab:
#   S3_ENDPOINT=http://ugarms-seaweedfs:8333
#   S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY as above (API and worker)
#   S3_DISPOSAL_ACCESS_KEY, S3_DISPOSAL_SECRET_KEY as above (API only; leave them out of the worker)

# Optional.
# SEAWEEDFS_VOLUME_SIZE_MB=1024   # size of each storage file SeaweedFS creates on disk
# S3_HOST_PORT=8333               # port on the server's loopback address, for SSH tunnels
