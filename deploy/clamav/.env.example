# Variables for docker-compose.dokploy.yml. All optional; paste any you change into the Dokploy deployment's
# Environment tab. ClamAV has no password.

# In the backend's Environment tab (API and worker):
#   CLAMAV_ENABLED=true
#   CLAMAV_HOST=ugarms-clamav
#   CLAMAV_PORT=3310

# CLAMAV_VERSION=1.5              # image tag; "stable" follows each new release
# CLAMAV_MAX_FILE_MB=2048         # largest file scanned; keep equal to the backend's MAX_UPLOAD_MB (at most 4095)
# CLAMAV_UPDATES_PER_DAY=4        # signature update checks per day
# CLAMAV_CONCURRENT_RELOAD=no     # "yes" keeps scanning during the daily reload but needs about twice the RAM
# CLAMAV_HOST_PORT=3310           # port on the server's loopback address, for SSH tunnels
# TZ=Africa/Accra
