# Variables for docker-compose.dokploy.yml. Paste these into the Dokploy deployment's Environment tab with your own
# values (Dokploy writes them to .env beside the compose file). Never commit real values.
#
# SQL Server refuses weak passwords: use at least 8 characters with three of upper case, lower case, digits and
# symbols. Avoid $ in values (Compose treats it as the start of a variable) or wrap the whole value in single quotes.

# Administrator (sa). Used only by mssql-init and by a DBA; never give it to the application.
MSSQL_SA_PASSWORD=

# The application's database and login. Copy the same DB_NAME, DB_USER and DB_PASSWORD into the backend's
# Environment tab, with DB_HOST=ugarms-mssql and DB_PORT=1433.
DB_NAME=ug_arms
DB_USER=ugarms_app
DB_PASSWORD=

# Optional.
# MSSQL_PID=Express            # Express (free, 10 GB per database), or Standard / Enterprise with a licence
# MSSQL_MEMORY_LIMIT_MB=2048   # SQL Server needs at least 2 GB of RAM on the server
# MSSQL_HOST_PORT=1433         # port on the server's loopback address, for SSH tunnels
# TZ=Africa/Accra
