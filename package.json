{
  "name": "ug-arms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/jobs/worker.js",
    "db:create": "node src/database/cli.js create",
    "db:migrate": "node src/database/cli.js up",
    "db:rollback": "node src/database/cli.js down",
    "db:seed": "node src/database/cli.js seed",
    "db:reset": "node src/database/cli.js reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit --omit=dev",
    "setup:dev": "node scripts/setup-dev-env.mjs",
    "admin:reset": "node scripts/reset-admin.mjs",
    "search:reindex": "node scripts/reindex-search.mjs",
    "restore:verify": "node scripts/verify-restore.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \"*.config.js\"",
    "storage:check": "node scripts/check-object-store.mjs",
    "storage:lock": "node scripts/object-lock-sweep.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/lib-storage": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "archiver": "^7.0.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.0",
    "bwip-js": "4.11.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "openapi-types": "^12.1.3",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^19.2.2",
    "tesseract.js": "^7.0.0",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@azure/identity": "4.14.1"
  },
  "scarfSettings": {
    "enabled": false
  }
}
