# UG-ARMS backend configuration. Placeholder values only — never commit real secrets.
# For local development run `npm run setup:dev` to generate a working .env automatically.
# Every value is validated at startup (src/config/env.js); production refuses placeholders.

NODE_ENV=development
PORT=4200
APP_NAME=UG-ARMS
# Public origin of the frontend (alias: FRONTEND_ORIGIN). Comma-separate several CORS origins.
PUBLIC_APP_URL=http://localhost:5190
CORS_ORIGINS=http://localhost:5190
TRUST_PROXY=false
# API documentation at /api/v1/docs. Leave unset: on in development, off in production.
# SWAGGER_ENABLED=true

# SQL Server. Use a least-privilege application login in production (infrastructure/scripts/db-least-privilege.sql).
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ug_arms
DB_USER=<application-login>
DB_PASSWORD="<application-password>"
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
DB_LOGGING=false

REDIS_URL=redis://localhost:6379
QUEUES_ENABLED=true

# 48+ random characters each, different from one another: openssl rand -base64 48
JWT_ACCESS_SECRET=<generate-a-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-random-secret>
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_DOMAIN=

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Object storage (aliases: OBJECT_STORAGE_ENDPOINT / _BUCKET / _ACCESS_KEY / _SECRET_KEY / _REGION)
STORAGE_DRIVER=s3
STORAGE_LOCAL_ROOT=./storage-local
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=ug-arms-objects
S3_ACCESS_KEY=<storage-access-key>
S3_SECRET_KEY=<storage-secret-key>
# Separate credential used only by the API to destroy files under authorised disposal. It can bypass governance
# retention, so it must differ from S3_ACCESS_KEY and must never be given to the worker. Leave empty to make files
# under retention impossible to destroy until their retention period ends.
S3_DISPOSAL_ACCESS_KEY=<disposal-access-key>
S3_DISPOSAL_SECRET_KEY=<disposal-secret-key>
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=2048

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="UG Archives <no-reply@example.invalid>"

CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
TIKA_ENABLED=false
TIKA_URL=http://localhost:9998
OCR_ENABLED=true
TESSERACT_PATH=tesseract
FFPROBE_PATH=ffprobe
# Optional remote OCR service (see docs/architecture.md for the contract). Leave unset to use local Tesseract.
OCR_SERVICE_URL=
# Bearer token sent to the OCR service, if it requires one.
OCR_SERVICE_TOKEN=
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200

# Optional AI assistance. Disabled by default; see docs/security-guide.md before enabling.
AI_ENABLED=false
AI_PROVIDER=none
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# Optional error-tracking webhook (receives JSON error summaries without personal data).
ERROR_WEBHOOK_URL=
DISK_FREE_ALERT_PERCENT=10
# Failed sign-ins (and registration/activation requests) allowed per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20

# Initial administrator. The account is created with mustChangePassword=true.
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<temporary-password-12+-chars>
SEED_DEMO_DATA=false
LOG_LEVEL=info
